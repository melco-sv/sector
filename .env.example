# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here

# Sectors Financial API key (https://sectors.app -> API Keys)
SECTORS_API_KEY=your-sectors-api-key-here

# MiniMax LLM (https://platform.minimax.io -> API Keys). Powers all agents.
MINIMAX_API_KEY=your-minimax-api-key-here
# Optional overrides:
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_BASE_URL=https://api.minimax.io/v1   # China: https://api.minimaxi.com/v1
