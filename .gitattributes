# Normalize line endings across all platforms.
# Text files are stored with LF in the repo and checked out with LF everywhere,
# preventing spurious CRLF/LF diffs on mixed Windows/Mac/Linux teams.
* text=auto eol=lf

# Windows-only scripts must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
